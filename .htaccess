# ==========================================================================
# Clean addresses
# ==========================================================================

Options -MultiViews
Options -Indexes

RewriteEngine On


# ==========================================================================
# 1. Scripts that must remain accessible by filename
# ==========================================================================

RewriteRule ^(blog|raffle)\.php$ - [L]

RewriteRule ^admin/(submit|file|drawer|receipt|receipt-pdf|raffle-search)\.php$ - [L]

RewriteRule ^portal/(session|prefill|receipt)\.php$ - [L]

RewriteRule ^distributor/proof\.php$ - [L]


# ==========================================================================
# 2. Redirect .html and .php URLs to clean URLs
# Only redirect browser GET requests
# ==========================================================================

RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.(php|html)[?\s] [NC]
RewriteRule ^(.*/)?index\.(php|html)$ /%1 [R=301,L]

RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+(.+)\.(php|html)[?\s] [NC]
RewriteRule ^(.+)\.(php|html)$ /$1 [R=301,L]


# ==========================================================================
# 3. Clean URL -> HTML file
# ==========================================================================

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]


# ==========================================================================
# 4. Clean URL -> PHP file
# ==========================================================================

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]


# ==========================================================================
# Protect sensitive PHP files
# ==========================================================================

<FilesMatch "^(lib|config|mailer|emails|raffle-lib|receipt-pdf|xlsx)\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|md)$">
    Require all denied
</FilesMatch>


# ==========================================================================
# Protect Git and hidden files
# ==========================================================================

RedirectMatch 404 (?i)/\.git(/|$)

<FilesMatch "^\.">
    Require all denied
</FilesMatch>


# ==========================================================================
# Block development and internal folders
# ==========================================================================

RewriteRule ^(\.playwright[^/]*|\.reticle|graphify-out|admin/tests)(/|$) - [R=404,L,NC]


# ==========================================================================
# Security Headers
# ==========================================================================

<IfModule mod_headers.c>

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"

    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()"

    # HSTS, and only ever over TLS. Sent on a plain-HTTP install it would pin
    # this host to https:// in every browser that saw it — which on a laptop
    # running XAMPP locks the site out of itself with no way back but clearing
    # the browser's HSTS store. The condition is what makes it safe to keep in
    # a file that is deployed everywhere.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

</IfModule>


# ==========================================================================
# Compression
# ==========================================================================

<IfModule mod_deflate.c>
<IfModule mod_filter.c>

    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/x-javascript application/json application/xml application/rss+xml image/svg+xml font/ttf font/otf application/vnd.ms-fontobject

</IfModule>
</IfModule>


# ==========================================================================
# Browser caching
# ==========================================================================

<IfModule mod_expires.c>

    ExpiresActive On

    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    ExpiresByType font/woff2 "access plus 1 year"

    ExpiresByType text/html "access plus 0 seconds"

</IfModule>


# ==========================================================================
# Cache-Control headers
# ==========================================================================

<IfModule mod_headers.c>

    <FilesMatch "\.(css|js|webp|png|jpe?g|svg|woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

</IfModule>