# ==========================================================================
# Clean addresses
# ==========================================================================

Options -MultiViews
Options -Indexes

# Every file here is UTF-8. Apache's built-in default is ISO-8859-1, and the
# HTTP header beats the document's own <meta charset> — so without this the
# rupee signs and em dashes go out labelled as Latin-1.
AddDefaultCharset utf-8

RewriteEngine On


# ==========================================================================
# 1. Scripts that must remain accessible by filename
# ==========================================================================

RewriteRule ^(blog|raffle|seeder)\.php$ - [L]

RewriteRule ^admin/(submit|file|drawer|receipt|receipt-pdf|raffle-search)\.php$ - [L]

RewriteRule ^portal/(session|prefill|receipt)\.php$ - [L]

RewriteRule ^distributor/proof\.php$ - [L]


# ==========================================================================
# 2. Redirect .html and .php URLs to clean URLs
# Only redirect browser GET requests
# ==========================================================================

RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.(php|html)[?\s] [NC]
RewriteRule ^(.*/)?index\.(php|html)$ /%1 [R=301,L]

RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+(.+)\.(php|html)[?\s] [NC]
RewriteRule ^(.+)\.(php|html)$ /$1 [R=301,L]


# ==========================================================================
# 3. Clean URL -> HTML file
# ==========================================================================

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]


# ==========================================================================
# 4. Clean URL -> PHP file
# ==========================================================================

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]


# ==========================================================================
# Protect sensitive PHP files
# ==========================================================================

<FilesMatch "^(lib|config|mailer|emails|raffle-lib|receipt-pdf|xlsx)\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|md)$">
    Require all denied
</FilesMatch>


# ==========================================================================
# Protect Git and hidden files
# ==========================================================================

RedirectMatch 404 (?i)/\.git(/|$)

<FilesMatch "^\.">
    Require all denied
</FilesMatch>


# ==========================================================================
# Block development and internal folders
# ==========================================================================

RewriteRule ^(\.playwright[^/]*|\.reticle|graphify-out|admin/tests)(/|$) - [R=404,L,NC]


# ==========================================================================
# Security Headers
# ==========================================================================

<IfModule mod_headers.c>

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"

    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()"

    # HSTS, and only ever over TLS. Sent on a plain-HTTP install it would pin
    # this host to https:// in every browser that saw it — which on a laptop
    # running XAMPP locks the site out of itself with no way back but clearing
    # the browser's HSTS store. The condition is what makes it safe to keep in
    # a file that is deployed everywhere.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

</IfModule>


# ==========================================================================
# Compression
# ==========================================================================

# Brotli where the server has it, gzip where it does not. The two are kept
# mutually exclusive on purpose: listed together, both filters run on the same
# response and the client is handed gzip wrapped in brotli, which no browser can
# read. Hostinger loads mod_brotli, so that is the branch that runs in
# production; XAMPP has neither mod_brotli nor mod_filter, so it falls all the
# way through to the extension list at the bottom.
#
# The type list is the same in both. Note text/javascript: Apache 2.4's
# mime.types maps .js to text/javascript, not to application/javascript, so a
# list carrying only the latter quietly leaves every script uncompressed. That
# is invisible on a server without mod_filter, where the extension fallback
# picks .js up anyway — and it is exactly what was happening in production.
<IfModule mod_brotli.c>

    <IfModule mod_filter.c>
        AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml application/manifest+json image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
    </IfModule>

    # same fallback as the gzip branch, so no combination of loaded modules
    # ends up serving text uncompressed
    <IfModule !mod_filter.c>
        <FilesMatch "\.(css|js|html?|php|json|xml|svg|txt|map)$">
            SetOutputFilter BROTLI_COMPRESS
        </FilesMatch>
    </IfModule>

    <IfModule mod_headers.c>
        Header append Vary Accept-Encoding
    </IfModule>

</IfModule>


<IfModule !mod_brotli.c>
<IfModule mod_deflate.c>

    # By media type, which is the right way round — but AddOutputFilterByType is
    # mod_filter's directive, and a server without that module loaded skips this
    # whole block in silence. That is what left 390 KB of CSS going out raw.
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml application/manifest+json image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
    </IfModule>

    # The fallback for a server with mod_deflate and no mod_filter: by
    # extension, which mod_deflate can do on its own. Only text formats are
    # listed — compressing a WebP or a woff2 a second time costs CPU and saves
    # nothing.
    <IfModule !mod_filter.c>
        <FilesMatch "\.(css|js|html?|php|json|xml|svg|txt|map)$">
            SetOutputFilter DEFLATE
        </FilesMatch>
    </IfModule>

    # Proxies must not hand a gzipped copy to a client that cannot read one.
    <IfModule mod_headers.c>
        Header append Vary Accept-Encoding
    </IfModule>

</IfModule>
</IfModule>


# ==========================================================================
# Browser caching
# ==========================================================================

<IfModule mod_expires.c>

    ExpiresActive On

    ExpiresByType text/css "access plus 1 year"
    # both spellings: .js is text/javascript in Apache 2.4's mime.types
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"

    # Nothing here for text/html on purpose: mod_headers below owns it, and a
    # rule here only added a second Cache-Control line saying max-age=0 beside
    # the one that already says no-cache.

</IfModule>


# ==========================================================================
# Cache-Control headers
# ==========================================================================

<IfModule mod_headers.c>

    <FilesMatch "\.(css|js|mjs|webp|avif|png|jpe?g|gif|svg|ico|woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # "always", because mod_expires runs after a plain Header set and would put
    # its own max-age=0 back over the top of this one. Both say do not reuse
    # without asking, but only this one tells a shared cache it may hold a copy
    # and revalidate it.
    <FilesMatch "\.(html|php)$">
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

</IfModule>